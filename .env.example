# ── 第二阶段意图解析后端配置（仅服务端使用）──
# 复制为 .env 后填写；切勿将真实密钥提交到公开仓库或写入前端代码。

# DeepSeek API 密钥（仅服务端读取，浏览器不接触）。新建：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# DeepSeek OpenAI 兼容基址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 对话/意图模型（默认 deepseek-chat；如需推理版可改为 deepseek-reasoner）
DEEPSEEK_MODEL=deepseek-chat

# 后端服务端口（前端通过 Vite 代理 /api 访问）
PORT=8787

# 可选：设为 1 时强制使用内置规则 mock（非真实 AI），用于离线开发
# IMAGINE_MOCK=1

# ── 第三阶段：豆包（Doubao）图像/视频生成接口预留 ──
# 接入前本项目不调用任何外部生成 API；以下为 Stage 3 图像生成所需的安全约定。
# 火山方舟 API Key（仅服务端读取，浏览器不接触；接入后填写，切勿提交真实密钥）
ARK_API_KEY=ark-your-volcano-ark-key-here
# 图像模型 ID（Seedream 系列，例如 doubao-seedream-4-0-250828 / doubao-seedream-5-0-lite-260128）
ARK_IMAGE_MODEL_ID=doubao-seedream-5-0-lite-260128
# 可选：API 地域端点（默认北京）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
# 可选：开发/测试占位模式（=1 时不调用真实 API，写入本地占位图，便于联调与自动化测试）
# GENERATION_MOCK=1
# 视频生成模型（如字节豆包 Seedance 系列），接入后填写
# DOUBAO_VIDEO_MODEL=Doubao-Seedance-2.0

